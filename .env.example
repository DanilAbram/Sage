# Copy this file to .env.local and fill in your own values. Never commit .env.local or share these keys in chat.

# Free key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   # optional: preferred model (others are used as fallback)

# Stripe (use TEST mode first): https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=            # sk_test_...
STRIPE_PRICE_MONTHLY=         # price_... recurring monthly price (test mode)
STRIPE_PRICE_YEARLY=          # price_... recurring yearly price (test mode)
STRIPE_WEBHOOK_SECRET=        # whsec_... from `stripe listen` or the dashboard webhook

# Shown on the Contact page
NEXT_PUBLIC_CONTACT_EMAIL=

# Your public site address in production, e.g. https://sage.example (used for Stripe return links and origin checks)
NEXT_PUBLIC_SITE_URL=
# Optional: header your host sets with the real visitor IP (e.g. x-real-ip)
TRUSTED_IP_HEADER=
